# =============================================================================
# GraphGuard frontend image — builds the dashboard and serves it from nginx.
# =============================================================================
# The dist is baked into the image rather than shared through a volume. A named
# volume keeps whatever it was first populated with, so a rebuilt dashboard
# would silently never reach the browser; an image rebuild is atomic — after a
# deploy nginx serves either the old bundle or the new one, never a mix.
#
# The proxy config is baked in as the default. On the VPS a TLS-enabled variant
# is bind-mounted over it via docker-compose.override.yml, so certificates never
# require an image rebuild.
# =============================================================================

FROM node:22-alpine AS build

WORKDIR /app

# Dependency layer, cached independently of source: editing a component must not
# re-download the toolchain.
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
