# GraphGuard deployment settings — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values: the signing key alone is enough
# to mint an administrator token for the deployment it belongs to.
#
# Generate the two secrets with:
#   uv run python -c "from graphguard.platform.settings import generate_secret; print(generate_secret())"

# development | test | production
# In production the service refuses to start on the development signing key, on a
# key shorter than 32 characters, or on a SQLite database. A forgotten variable
# must crash at boot rather than silently sign tokens with a published value.
GRAPHGUARD_ENVIRONMENT=production

# Signs access and refresh tokens. Rotating it invalidates every issued token,
# which is the intended emergency response to a suspected compromise.
GRAPHGUARD_JWT_SECRET=

# Postgres password used by both the database container and the application URL.
POSTGRES_PASSWORD=

# Origins allowed to call the API from a browser, comma-separated. In the
# compose deployment nginx serves the dashboard from the same origin, so this
# matters mainly for a split-host setup or local frontend development.
GRAPHGUARD_CORS_ORIGINS=http://localhost

# Host port nginx binds to.
HTTP_PORT=80

# --- Optional overrides ------------------------------------------------------
# Short by design: a leaked access token stays useful only for this long.
# GRAPHGUARD_ACCESS_TOKEN_TTL_MINUTES=15
# Long, but revocable through the Redis denylist.
# GRAPHGUARD_REFRESH_TOKEN_TTL_DAYS=14
# GRAPHGUARD_AUTH_RATE_LIMIT=10/minute

# --- analyst assistant (optional, D39) ---------------------------------------
# Puts a tool-using language model behind the dashboard's assistant panel. Off by
# default: the report describes the platform without it, and turning it on sends
# alert metadata to the Anthropic API. Requires an API key when enabled.
GRAPHGUARD_ASSISTANT_ENABLED=false
# ANTHROPIC_API_KEY=
# GRAPHGUARD_ASSISTANT_MODEL=claude-opus-5
# Provider switch: "anthropic" (default) or "openai". The openai driver serves any
# OpenAI-compatible endpoint — leave the base URL empty for OpenAI itself, or set
# https://openrouter.ai/api/v1 with an OpenRouter key (model e.g. openai/gpt-5.6-sol).
# GRAPHGUARD_ASSISTANT_PROVIDER=openai
# GRAPHGUARD_ASSISTANT_BASE_URL=
# OPENAI_API_KEY=
